{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "cmake",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build", "${workspaceFolder}/../../../build/${workspaceFolderBasename}",
                "--config", "Debug"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$nvcc",
                "$gcc"
            ]
        }
    ]
}
